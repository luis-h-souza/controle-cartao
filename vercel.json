{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install && npm --prefix server run prisma:generate",
  "framework": null,
  "functions": {
    "api/[...path].ts": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "server/node_modules/.prisma/**,server/prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
