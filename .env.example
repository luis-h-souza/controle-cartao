# ============================================================
# Controle Cartão — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# Nunca comite o .env com valores reais!
# ============================================================

# --- Neon Database (Lakebase Postgres) ---
# URL com pool de conexão (para queries normais)
DATABASE_URL="postgresql://USER:SENHA@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# URL direta sem pool (para Prisma Migrate)
DATABASE_URL_UNPOOLED="postgresql://USER:SENHA@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# --- JWT ---
# Chave secreta para assinar access tokens (15 minutos)
JWT_SECRET="troque-por-uma-string-aleatoria-longa-e-segura"

# Chave secreta para assinar refresh tokens (7 dias)
JWT_REFRESH_SECRET="troque-por-outra-string-aleatoria-longa-e-segura"

# --- Servidor (apenas para desenvolvimento local) ---
PORT=3333
